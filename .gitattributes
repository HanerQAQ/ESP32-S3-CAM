# Auto detect text files and perform LF normalization on checkin
* text=auto eol=lf

# C / C++ and Embedded sources
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.ino text eol=lf

# Python & Tooling
*.py text eol=lf
*.spec text eol=lf
*.properties text eol=lf
*.lock text eol=lf

# Build systems & Configurations
CMakeLists.txt text eol=lf
*.cmake text eol=lf
Kconfig* text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
.gitignore text eol=lf
.editorconfig text eol=lf
.clang-format text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf
LICENSE text eol=lf
NOTICE text eol=lf

# Shell scripts
*.sh text eol=lf

# Windows scripts (must use CRLF)
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets (strictly prevent line-ending conversion)
*.espdl binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.icns binary
*.gz binary
*.bin binary
*.elf binary
*.map binary
